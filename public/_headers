/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://*.highperformanceformat.com https://*.adsterra.com https://biomanos.org https://*.biomanos.org https://benchform.org 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co https://challenges.cloudflare.com https://biomanos.org https://*.biomanos.org; frame-src https:; media-src 'self' https: blob: data:; font-src 'self' data: https://cdnjs.cloudflare.com; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

/admin_generate
  Cache-Control: no-store, max-age=0, must-revalidate
/admin_generate.html
  Cache-Control: no-store, max-age=0, must-revalidate
/admin.js
  Cache-Control: no-store, max-age=0, must-revalidate
/api/*
  Cache-Control: no-store, max-age=0, must-revalidate
